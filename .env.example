# Auth0 tenant config
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-mcp-api/

# Auth0 M2M client — used by CIBA and Token Vault authorizers
AUTH0_CLIENT_ID=your-m2m-client-id
AUTH0_CLIENT_SECRET=your-m2m-client-secret

# Auth0 client authorized for RFC 8693 token exchange — used by payInvoice OBO flow
AUTH0_TOKEN_EXCHANGE_CLIENT_ID=your-token-exchange-client-id
AUTH0_TOKEN_EXCHANGE_CLIENT_SECRET=your-token-exchange-client-secret

# Auth0 client authorized for RFC 8693 token exchange — used by deactivateMember OBO flow
# Exchange portal token for admin.widget.com token (deactivateMembers scope)
AUTH0_ADMIN_TOKEN_EXCHANGE_CLIENT_ID=your-admin-token-exchange-client-id
AUTH0_ADMIN_TOKEN_EXCHANGE_CLIENT_SECRET=your-admin-token-exchange-client-secret

# Auth0 FGA (Fine-Grained Authorization)
FGA_STORE_ID=your-fga-store-id
FGA_CLIENT_ID=your-fga-client-id
FGA_CLIENT_SECRET=your-fga-client-secret
# Optional overrides (defaults point to Auth0 FGA US1)
# FGA_API_URL=https://api.us1.fga.dev
# FGA_API_TOKEN_ISSUER=auth.fga.dev
# FGA_API_AUDIENCE=https://api.us1.fga.dev/

# Gmail — recipient address for inventory notifications (sent via Token Vault OBO token)
# The authenticated user's Google account (google-oauth2 connection) sends the email.
NOTIFICATION_EMAIL_TO=recipient@example.com

# Vercel deployment URL (used in MCP resource metadata)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
